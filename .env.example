# Application URLs & Configuration
APP_URL=https://tryledgermate.in

# Google OAuth 2.0 (Optional user sign-in & group tracking)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://tryledgermate.in/auth/google/callback

# Resend Email Service (Optional 48h expiration notices)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=LedgerMate <notifications@yourdomain.com>

# Cryptographic Token & Session Signing
EXTEND_SECRET=your-long-random-secret-key-at-least-32-chars

# Google Gemini API (For AI Calculation Agent inference)
GEMINI_API_KEY=your-gemini-api-key
