{
  "name": "splitmate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create splitmate-db",
    "db:migrate:local": "wrangler d1 migrations apply splitmate-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply splitmate-db --remote"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
